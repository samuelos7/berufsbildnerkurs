{"nodes": [{"id": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre", "label": "Grundlagen zur Schnupperlehre (Arbeitsblatt Aufgabe 1)", "file_type": "document", "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_schnupperlehre", "label": "Schnupperlehre (3-5 betreute Tage, in der Praxis oft nur ein Tag)", "file_type": "rationale", "rationale": "Die Schnupperlehre hilft beiden Seiten bei der Entscheidung: Jugendliche lernen durch praktisches Arbeiten die Atmosph\u00e4re des Betriebs kennen, vergleichen eigene Interessen mit den Berufsanforderungen und pr\u00fcfen, ob der Beruf ihrer Vorstellung entspricht; der Betrieb pr\u00fcft die Eignung und erkennt schnell, ob grundlegende F\u00e4higkeiten vorhanden sind. Es braucht auch Betriebe, die offen sind f\u00fcr Lernende, die nicht zu 100% passen.", "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_beurteilungsbogen", "label": "Beurteilungsbogen der Schnupperlehre", "file_type": "rationale", "rationale": "Beobachtungen aus der Schnupperlehre werden von den Berufsbildner/innen auf einem Beurteilungsbogen festgehalten; die Jugendlichen nehmen ihn mit, er kann sie in ihrer weiteren Entwicklung unterst\u00fctzen.", "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_abschlussgespr\u00e4ch", "label": "Abschlussgespr\u00e4ch am Ende der Schnupperlehre (Austausch gegenseitiger Erfahrungen)", "file_type": "concept", "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre", "target": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_schnupperlehre", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_abschlussgespr\u00e4ch", "target": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_schnupperlehre", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_beurteilungsbogen", "target": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_schnupperlehre", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_beurteilungsbogen", "target": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_abschlussgespr\u00e4ch", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "material/Tag 3/Aufgabe 1/WBZLU BEKU_1_Grundlagen zur Schnupperlehre.pdf", "source_location": "p. 1", "weight": 1.0}, {"source": "material_tag_3_aufgabe_1_wbzlu_beku_1_grundlagen_zur_schnupperlehre_schnupperlehre", "